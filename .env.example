# Copie este arquivo para ".env" e preencha. NADA disso fica fixo no código.

# --- Banco de dados ---
# Opções de DB_DIALECT: sqlite | mysql+pymysql | postgresql+psycopg2
DB_DIALECT=sqlite
# Para sqlite, só DB_NAME é usado (nome do arquivo, ex: tde.db).
# Para MySQL/PostgreSQL, preencha também host, porta, usuário e senha.
DB_HOST=
DB_PORT=
DB_NAME=tde.db
DB_USER=
DB_PASSWORD=

# --- JWT ---
# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRES_MINUTES=60

# --- Senha padrão usada no reset de senha (tarefa do Allan) ---
SENHA_PADRAO=

# --- Execução ---
FLASK_DEBUG=1
